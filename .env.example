# Public origin of the deployed site, without a trailing slash (used for og:url and og:image). Leave empty until the
# domain is decided: og:url is then left out and og:image stays a relative path.
VITE_PUBLIC_SITE_URL=

# Support address shown on the homepage (FAQ and footer Contact link). Leave empty to hide both.
VITE_SUPPORT_EMAIL=

# Local development only: prefills the login form. Put real values in .env.development.local (gitignored), never here.
VITE_DEV_LOGIN_EMAIL=
VITE_DEV_LOGIN_PASSWORD=

# Local development only: where the dev server forwards /api. Defaults to http://localhost:5050 (port 5000 is taken by
# macOS AirPlay). Set it to point the frontend at another API, e.g. one running on another port.
VITE_DEV_API_PROXY=

# Local development only: VITE_MOCK_FEATURES=beta pretends the API runs the closed beta (payments off, registration closed)
# without a backend that has the Features switches. Ignored in a production build.
VITE_MOCK_FEATURES=

# Local development only, until the AI draft endpoint exists: VITE_MOCK_AI=ok|refused|failed|rate|limit answers the
# "Generate with AI" call like the API would (ok saves a real draft). VITE_MOCK_AI_SECONDS sets how long it takes (12).
VITE_MOCK_AI=
VITE_MOCK_AI_SECONDS=
